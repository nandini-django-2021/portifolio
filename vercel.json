{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": ".",
  "env": [
    {
      "key": "ANTHROPIC_API_KEY",
      "description": "Your Anthropic API key for Claude AI",
      "type": "secret",
      "value": ""
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
